# Copy to .env for local runs. EVERY variable here must also be set in the Vercel dashboard.

# Server secret for HMAC-ing phone numbers and bank accounts. Long and random. Never commit it.
# Changing it breaks matching against reports already stored.
PHONE_HMAC_SECRET=change-me

# Model. Without a key, checks run on code-side extraction only (screenshots still work: OCR is in the browser).
# Free tier is fine: text is redacted before it's sent (see docs/DEPLOY.md step 2).
GEMINI_API_KEY=
# IDs checked 6 Oct 2026. gemini-3.8-flash is the newest stable Flash if 3.5 underperforms.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Community reports database. Set both to use Turso; otherwise SQLite at DATABASE_PATH.
# On Vercel, adding "Turso Cloud" from the project's Storage tab sets these two for you.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_PATH=chaincheck.sqlite3

# 1 = add the 12 labelled SYNTHETIC reports on first start if none exist.
SEED_DEMO_REPORTS=1

# Token for the review queue at /#/admin. Empty disables the queue.
ADMIN_TOKEN=
